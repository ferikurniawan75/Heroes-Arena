<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="@dimen/padding_sm">

    <!-- Hero Grid (Left) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECT HERO"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="@dimen/padding_sm" />

        <!-- Class Filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgClassFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_xs">

                <RadioButton android:id="@+id/rbAll" android:text="All" android:checked="true"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbTank" android:text="Tank"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbFighter" android:text="Fighter"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbAssassin" android:text="Assassin"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbMage" android:text="Mage"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbMarksman" android:text="Marksman"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent"
                    android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rbSupport" android:text="Support"
                    android:textColor="@color/text_primary" android:buttonTint="@color/accent" />
            </RadioGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHeroes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/padding_sm" />

        <TextView
            android:id="@+id/tvGameMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classic 5v5"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_md"
            android:gravity="center"
            android:padding="@dimen/padding_sm" />
    </LinearLayout>

    <!-- Hero Detail (Right) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_md">

        <TextView
            android:id="@+id/tvSelectedHeroName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a Hero"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_md" />

        <TextView
            android:id="@+id/tvSelectedHeroClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/padding_xs" />

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/padding_lg">

            <TextView android:id="@+id/tvHpStat" android:text="HP" android:textColor="@color/hp_green" android:textSize="@dimen/text_sm" />
            <ProgressBar android:id="@+id/pbHp" style="@style/HeroStatBar" android:layout_width="match_parent"
                android:progressTint="@color/hp_green" android:progressBackgroundTint="@color/divider" />

            <TextView android:id="@+id/tvAtkStat" android:text="ATK" android:textColor="@color/team_red_light" android:textSize="@dimen/text_sm" android:layout_marginTop="4dp" />
            <ProgressBar android:id="@+id/pbAtk" style="@style/HeroStatBar" android:layout_width="match_parent"
                android:progressTint="@color/team_red_light" android:progressBackgroundTint="@color/divider" />

            <TextView android:id="@+id/tvDefStat" android:text="DEF" android:textColor="@color/mp_blue" android:textSize="@dimen/text_sm" android:layout_marginTop="4dp" />
            <ProgressBar android:id="@+id/pbDef" style="@style/HeroStatBar" android:layout_width="match_parent"
                android:progressTint="@color/mp_blue" android:progressBackgroundTint="@color/divider" />

            <TextView android:id="@+id/tvSpdStat" android:text="SPD" android:textColor="@color/xp_orange" android:textSize="@dimen/text_sm" android:layout_marginTop="4dp" />
            <ProgressBar android:id="@+id/pbSpd" style="@style/HeroStatBar" android:layout_width="match_parent"
                android:progressTint="@color/xp_orange" android:progressBackgroundTint="@color/divider" />
        </LinearLayout>

        <!-- Lore -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/padding_md">

            <TextView
                android:id="@+id/tvSelectedHeroLore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm"
                android:lineSpacingExtra="2dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnConfirm"
            style="@style/GameButton.Gold"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIRM &amp; PLAY"
            android:textSize="@dimen/text_lg"
            android:layout_marginTop="@dimen/padding_sm" />
    </LinearLayout>
</LinearLayout>
