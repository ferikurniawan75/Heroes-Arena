<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/padding_sm"
        android:background="@color/bg_card">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← BACK"
            android:textSize="@dimen/text_sm"
            style="@style/GameButton.Primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SHOP"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvShopGold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5000g"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_md"
            android:layout_marginEnd="@dimen/padding_md" />

        <TextView
            android:id="@+id/tvShopDiamonds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="@color/mp_blue"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

    <!-- Category Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bg_card">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_xs">

            <Button android:id="@+id/btnCatAttack" android:text="⚔ Attack" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnCatMagic" android:text="✨ Magic" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnCatDefense" android:text="🛡 Defense" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnCatMovement" android:text="👟 Movement" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnCatJungle" android:text="🌿 Jungle" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnCatRoam" android:text="🗺 Roam" style="@style/GameButton.Primary"
                android:layout_width="wrap_content" android:layout_height="36dp" android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Item Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShopItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/padding_sm" />

</LinearLayout>
