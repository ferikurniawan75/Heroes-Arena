<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_md"
            android:paddingBottom="@dimen/padding_md" />

        <TextView
            android:id="@+id/tvDetailHeroName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hero Name"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Title"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_lg" />

        <TextView
            android:id="@+id/tvDetailHeroClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_md"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/padding_xs" />

        <TextView
            android:id="@+id/tvDetailHeroLore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_md"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="@dimen/padding_lg" />
    </LinearLayout>
</ScrollView>
