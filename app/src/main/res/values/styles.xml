<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HeroesArena" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.HeroesArena.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="GameButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="GameButton.Primary">
        <item name="backgroundTint">@color/btn_primary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GameButton.Gold">
        <item name="backgroundTint">@color/btn_gold</item>
        <item name="android:textColor">@color/bg_dark</item>
    </style>

    <style name="GameButton.Danger">
        <item name="backgroundTint">@color/btn_danger</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GameCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="HeroStatBar">
        <item name="android:layout_height">6dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:max">100</item>
        <item name="android:progress">50</item>
    </style>

    <style name="SkillButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
